// Tambahkan import ke app/Models/Peminjaman.php jika model ini sudah ada.
use App\Models\User;
use Illuminate\Database\Eloquent\Relations\BelongsTo;

// Tambahkan method ini ke dalam class Peminjaman:
public function user(): BelongsTo
{
    return $this->belongsTo(User::class);
}

